<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/adminHome"
    android:paddingTop="15dp"
    tools:context=".Categories_Base_CustomerProduct_Show">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.mancj.materialsearchbar.MaterialSearchBar
                android:id="@+id/material_search_bar"
                style="@style/MaterialSearchBarLight"
                app:mt_speechMode="true"
                app:mt_hint="Search products"
                app:mt_placeholder="Search..."
                app:mt_maxSuggestionsCount="10"
                app:mt_textColor="@color/blue"
                app:mt_navIconEnabled="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:layout_alignParentTop="true" />

            <TextView
                android:id="@+id/category_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/material_search_bar"
                android:layout_marginTop="10dp"
                android:layout_marginStart="15dp"
                android:textSize="25sp"
                android:gravity="center"
                android:textStyle="bold"
                android:textColor="@android:color/black" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_view2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@id/category_title"
                android:layout_marginStart="5dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="5dp"
                android:scrollbars="vertical" />

            <!-- TextView for "No products found" message -->
            <TextView
                android:id="@+id/no_products_found"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="16dp"
                android:text="No products found"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:gravity="center"
                android:visibility="gone" />
        </RelativeLayout>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</RelativeLayout>
