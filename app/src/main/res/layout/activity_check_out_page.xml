<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/adminHome"
    tools:context=".Check_Out_Page">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/palce_order"

        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical">


            <!-- title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Shipping and Billing Information"
                android:gravity="center"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="15dp"
                android:textColor="@color/black" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/shipping_subtitle"
                android:gravity="center"
                android:textSize="12sp"
                android:textStyle="italic"
                android:textColor="@color/black" />




            <!-- Order shipping Section -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="20dp"
                android:background="@color/white"
                >

                <View
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:background="#D2D2D2" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="#F6EEEE"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:text="Shipping Information"
                        android:textColor="@color/black"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/expand_shipping"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/down" />
                </LinearLayout>



                <!-- expand_shipping_information -->
                <LinearLayout
                    android:id="@+id/expand_shipping_information"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:padding="20dp"
                    android:background="@color/white"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Recipent's Name *"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#EA5B5B"
                        android:paddingStart="10dp"

                        />
                    <!-- customer_name edittext -->
                    <EditText
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:id="@+id/customer_name"
                        android:background="@drawable/custom_edittext"
                        android:layout_marginTop="5dp"
                        android:padding="8dp"
                        android:hint="Please input your real name"
                        android:textStyle="italic"
                        android:inputType="textPersonName"
                        android:textSize="15sp"
                        android:drawableStart="@drawable/name"
                        android:drawablePadding="8dp"
                        android:textColor="@color/black"
                        android:autofillHints="name"
                        android:layout_marginBottom="15dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Email address *"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#EA5B5B"
                        android:paddingStart="10dp"
                        />

                    <!-- cusromer_email -->
                    <EditText
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:id="@+id/cusromer_email"
                        android:background="@drawable/custom_edittext"
                        android:layout_marginTop="5dp"
                        android:padding="8dp"
                        android:inputType="textEmailAddress"
                        android:hint="example@gmail.com"
                        android:textSize="15sp"
                        android:drawableStart="@drawable/email_icon"
                        android:drawablePadding="8dp"
                        android:textColor="@color/black"
                        android:autofillHints="phone"
                        android:layout_marginBottom="15dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Phone Number *"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#EA5B5B"
                        android:paddingStart="10dp"/>

                    <!-- customer_mobile -->
                    <EditText
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:id="@+id/customer_mobile"
                        android:background="@drawable/custom_edittext"
                        android:layout_marginTop="5dp"
                        android:padding="8dp"
                        android:inputType="phone"
                        android:hint="Please input your mobile number"
                        android:textSize="15sp"
                        android:drawableStart="@drawable/mobile"
                        android:drawablePadding="8dp"
                        android:textColor="@color/black"
                        android:autofillHints="phone"
                        android:layout_marginBottom="15dp" />

                    <!-- snipper for Region and District -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp">

                        <!-- Region Section -->
                        <LinearLayout
                            android:id="@+id/region_section"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_alignParentStart="true">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Region *"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="5dp"
                                android:textColor="#EA5B5B"
                                android:paddingStart="10dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:background="@drawable/custom_edittext">

                                <Spinner
                                    android:id="@+id/region_spinner"
                                    android:layout_width="140dp"
                                    android:layout_height="wrap_content"
                                    android:paddingStart="30dp"
                                    android:layout_gravity="center" />
                            </LinearLayout>
                        </LinearLayout>


                        <!-- District Section -->
                        <LinearLayout
                            android:id="@+id/district_section"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_alignParentEnd="true">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="District *"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#EA5B5B"
                                android:layout_marginBottom="5dp"
                                android:paddingStart="10dp"
                                />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:background="@drawable/custom_edittext">

                                <Spinner
                                    android:id="@+id/district_spinner"
                                    android:layout_width="140dp"
                                    android:layout_height="wrap_content"
                                    android:paddingStart="30dp"
                                    android:layout_gravity="center" />
                            </LinearLayout>
                        </LinearLayout>

                    </RelativeLayout>


                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp">

                        <!-- Upozila Section -->
                        <LinearLayout
                            android:id="@+id/upozila_section"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_alignParentStart="true">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Upozila *"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="5dp"
                                android:textColor="#EA5B5B"
                                android:paddingStart="10dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:background="@drawable/custom_edittext">

                                <Spinner
                                    android:id="@+id/upazila_spinner"
                                    android:layout_width="140dp"
                                    android:layout_height="wrap_content"
                                    android:paddingStart="30dp"
                                    android:layout_gravity="center" />
                            </LinearLayout>
                        </LinearLayout>
                    </RelativeLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Address *"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#EA5B5B"
                        android:paddingStart="10dp"/>

                    <EditText
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:id="@+id/address"
                        android:background="@drawable/custom_edittext"
                        android:layout_marginTop="5dp"
                        android:padding="8dp"
                        android:inputType="textPostalAddress"
                        android:hint="House no./building/street/area"
                        android:textSize="15sp"
                        android:drawableStart="@drawable/ic_location"
                        android:drawablePadding="8dp"
                        android:textColor="@color/black"
                        android:autofillHints="postalAddress"
                        android:layout_marginBottom="10dp" />

                </LinearLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="8dp"
                    android:background="#D2D2D2" />
            </LinearLayout>




            <!-- Order Summary Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:orientation="vertical">



                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp"
                    android:background="#F6EEEE">



                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Show Order Summary"
                        android:textColor="@color/black"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:layout_marginEnd="10dp" />



                    <TextView
                        android:id="@+id/grant_total"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="0.00"
                        android:textColor="#E13131"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginStart="30dp"
                        android:gravity="end" />




                </LinearLayout>



                <LinearLayout
                    android:id="@+id/expand_order_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/order_recycleview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="20dp"
                        android:layout_marginBottom="5dp"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="8dp"
                        android:background="#D2D2D2" />

                    <RelativeLayout
                        android:id="@+id/calculation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:padding="20dp"
                        >


                        <TextView
                            android:id="@+id/Subtotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_alignParentTop="true"
                            android:text="@string/subtotal"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/Subtotal_price"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentTop="true"
                            android:layout_alignParentEnd="true"
                            android:text="@string/_0_00"
                            android:textColor="@color/blue"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/Delivery"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/Subtotal"
                            android:layout_alignParentStart="true"
                            android:layout_marginTop="10dp"
                            android:text="@string/delivery"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/Delivery_price"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/Subtotal_price"
                            android:layout_alignParentEnd="true"
                            android:layout_marginTop="10dp"
                            android:text="@string/_0_00"
                            android:textColor="@color/blue"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/Tax"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/Delivery"
                            android:layout_alignParentStart="true"
                            android:layout_marginTop="10dp"
                            android:text="@string/total_tax"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/Tax_price"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/Delivery_price"
                            android:layout_alignParentEnd="true"
                            android:layout_marginTop="10dp"
                            android:text="@string/_0_00"
                            android:textColor="@color/blue"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <View
                            android:id="@+id/view2"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_below="@id/Tax_price"
                            android:layout_marginTop="8dp"
                            android:background="#D2D2D2" />

                        <TextView
                            android:id="@+id/Total"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/view2"
                            android:layout_alignParentStart="true"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="8dp"
                            android:text="@string/total"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/Total_price"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/view2"
                            android:layout_alignParentEnd="true"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="8dp"
                            android:text="@string/_0_00"
                            android:textColor="@color/blue"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </RelativeLayout>
                </LinearLayout>
            </LinearLayout>


        </LinearLayout>
    </ScrollView>


    <Button
        android:id="@+id/palce_order"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerInParent="true"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/custom_button"
        android:backgroundTint="@color/lavender"
        android:padding="10dp"
        android:text="Place order" />

</RelativeLayout>
